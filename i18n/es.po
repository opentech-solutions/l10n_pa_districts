#. module: l10n_pa_districts
#: model:ir.model.fields,field_description:l10n_pa_districts.field_res_country__cities_or_districts
msgid "Uses \"Districts\" terminology"
msgstr "Usa terminología de \"Distritos\""

#. module: l10n_pa_districts
#: model:ir.model.fields,help:l10n_pa_districts.field_res_country__cities_or_districts
msgid ""
"Indicates whether this country's administrative subdivision below "
"'state_id' is called a 'District' instead of a 'City'.\n"
"If checked: the city_id field is rendered with the label 'District' "
"and placeholder 'District...'.\n"
"If unchecked (default, like most countries): the city_id field is "
"rendered with the label 'City' and placeholder 'City...'.\n"
"Use this for countries whose subdivisions below the province/state "
"are formally called districts. Example: Panama (PA), where the 83 "
"subdivisions are 'distritos'."
msgstr ""
"Indica si la subdivisión administrativa de este país debajo de "
"'state_id' se llama 'Distrito' en lugar de 'Ciudad'.\n"
"Si está marcado: el campo city_id se muestra con la etiqueta "
"'District' y el placeholder 'District...'.\n"
"Si está desmarcado (valor por defecto, como la mayoría de países): "
"el campo city_id se muestra con la etiqueta 'City' y el placeholder "
"'City...'.\n"
"Use esto para países cuyas subdivisiones debajo de la "
"provincia/estado se denominan formalmente distritos. Ejemplo: Panamá "
"(PA), donde las 83 subdivisiones son 'distritos'."

#. module: l10n_pa_districts
#: model:ir.model.fields,field_description:l10n_pa_districts.field_res_partner__city_id_placeholder
msgid "City Placeholder"
msgstr "Placeholder de Ciudad"

#. module: l10n_pa_districts
#: model:ir.model.fields,help:l10n_pa_districts.field_res_partner__city_id_placeholder
msgid ""
"Dynamic placeholder for the city_id field. Set to 'District...' when "
"the country uses districts (cities_or_districts=True), otherwise "
"'City...'."
msgstr ""
"Placeholder dinámico para el campo city_id. Es 'District...' / "
"'Distrito...' cuando el país usa distritos (cities_or_districts=True), "
"en caso contrario 'City...' / 'Ciudad...'."

