#. module: l10n_pa_districts
#: model:ir.model.fields,field_description:l10n_pa_districts.field_res_country__cities_or_districts
msgid "Uses \"Districts\" terminology"
msgstr "Uses \"Districts\" terminology"

#. module: l10n_pa_districts
#: model:ir.model.fields,help:l10n_pa_districts.field_res_country__cities_or_districts
msgid ""
"Indicates whether this country's administrative subdivision below "
"'state_id' should be labelled as 'District'.\n"
"If checked (default for most countries): the subdivision is rendered "
"as 'District' / 'Distrito' in forms and views.\n"
"If unchecked: the subdivision is rendered as 'City' / 'Ciudad'.\n"
"Example: Panama's 83 subdivisions are formally called 'distritos' but "
"in this module they are loaded as res.city, so the flag is initialized "
"to False and Odoo renders them as 'City' / 'Ciudad'."
msgstr ""
"Indicates whether this country's administrative subdivision below "
"'state_id' should be labelled as 'District'.\n"
"If checked (default for most countries): the subdivision is rendered "
"as 'District' / 'Distrito' in forms and views.\n"
"If unchecked: the subdivision is rendered as 'City' / 'Ciudad'.\n"
"Example: Panama's 83 subdivisions are formally called 'distritos' but "
"in this module they are loaded as res.city, so the flag is initialized "
"to False and Odoo renders them as 'City' / 'Ciudad'."

