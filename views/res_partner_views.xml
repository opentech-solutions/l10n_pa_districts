<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        ===========================================================================
        l10n_pa_districts - res.partner views
        ===========================================================================

        NO usamos label dinámico en el formulario de contactos. El campo
        city_id se muestra sin etiqueta visible; el usuario final identifica
        el campo por su placeholder.

        El placeholder es dinámico: Odoo lee el campo computado
        city_id_placeholder (definido en models/res_country.py sobre
        res.partner) según el flag cities_or_districts del país:

            cities_or_districts = True  → "District..."  (país usa distritos)
            cities_or_districts = False → "City..."      (default, mayoría)

        Para Panamá (base.pa) el módulo inicializa cities_or_districts=True
        en data/res_country_data.xml, por lo que el placeholder visible
        será "District..." / "Distrito...".

        El resto de países del mundo mantiene el default False, mostrando
        "City..." / "Ciudad...".
    -->

    <!--
        1) Vista principal del partner (Empresa y Contacto individual).

        Heredamos de base_address_extended.address_street_extended_city_form
        (que es donde está el campo city_id).
    -->
    <record id="view_partner_form_inherit_city_filter_pa" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.city.filter.pa</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base_address_extended.address_street_extended_city_form"/>
        <field name="arch" type="xml">
            <!--
                Filtra city_id por país + provincia, define placeholder
                inicial como "City or District" (se sobreescribirá por
                el placeholder_field dinámico una vez cargado el record)
                y activa el placeholder dinámico nativo de Odoo.
            -->
            <field name="city_id" position="attributes">
                <attribute name="domain">['|', ('state_id', '=', False), '&amp;', ('country_id', '=', country_id), '|', ('state_id', '=', state_id), ('state_id', '=', False)]</attribute>
                <attribute name="placeholder">City or District</attribute>
                <attribute name="options">{'placeholder_field': 'city_id_placeholder', 'no_quick_create': True}</attribute>
            </field>
            <!--
                Suprime la etiqueta (label) del field city_id y city.
                El usuario identificará el campo por su placeholder.
            -->
            <field name="city_id" position="attributes">
                <attribute name="nolabel">1</attribute>
            </field>
            <field name="city" position="attributes">
                <attribute name="nolabel">1</attribute>
            </field>
        </field>
    </record>

    <!--
        2) Vista del formulario embedido de child_ids (direcciones de
            contacto dentro de una empresa).
    -->
    <record id="view_partner_form_inherit_child_city_filter_pa" model="ir.ui.view">
        <field name="name">res.partner.form.child.city.filter.pa</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base_address_extended.address_street_extended_city_form"/>
        <field name="arch" type="xml">
            <!-- Filtra el city_id dentro del xpath de child_ids, define placeholder
                inicial y activa el placeholder dinámico nativo. -->
            <xpath expr="//field[@name='child_ids']//field[@name='city_id']" position="attributes">
                <attribute name="domain">['|', ('state_id', '=', False), '&amp;', ('country_id', '=', country_id), '|', ('state_id', '=', state_id), ('state_id', '=', False)]</attribute>
                <attribute name="placeholder">City or District</attribute>
                <attribute name="options">{'placeholder_field': 'city_id_placeholder', 'no_quick_create': True}</attribute>
                <attribute name="nolabel">1</attribute>
            </xpath>
            <!-- Suprime el label del campo city embebido también -->
            <xpath expr="//field[@name='child_ids']//field[@name='city']" position="attributes">
                <attribute name="nolabel">1</attribute>
            </xpath>
        </field>
    </record>

</odoo>