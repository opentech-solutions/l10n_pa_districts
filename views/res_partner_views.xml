<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        ===========================================================================
        l10n_pa_districts - res.partner views
        ===========================================================================

        Hace que el LABEL y el PLACEHOLDER del campo city_id cambien
        dinámicamente según el flag cities_or_districts del país:

            cities_or_districts = True  → "District"  (país usa distritos)
            cities_or_districts = False → "City"      (default, mayoría países)

        Para el LABEL se usan dos <label for="..."> con atributos invisible
        mutuamente excluyentes (técnica estándar de Odoo v19).

        Para el PLACEHOLDER se usa la opción nativa de Odoo
        options="{'placeholder_field': 'city_id_placeholder'}" que lee
        dinámicamente el valor del campo computado city_id_placeholder
        definido en res.partner (models/res_country.py).
    -->

    <!--
        1) Vista principal del partner (Empresa y Contacto individual).

        Heredamos de base_address_extended.address_street_extended_city_form
        (que es donde está el campo city_id).
    -->
    <record id="view_partner_form_inherit_city_filter_pa" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.city.filter.pa</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base_address_extended.address_street_extended_city_form"/>
        <field name="arch" type="xml">
            <!-- Filtra city_id por país + provincia -->
            <field name="city_id" position="attributes">
                <attribute name="domain">['|', ('state_id', '=', False), '&amp;', ('country_id', '=', country_id), '|', ('state_id', '=', state_id), ('state_id', '=', False)]</attribute>
                <attribute name="options">{'placeholder_field': 'city_id_placeholder', 'no_quick_create': True}</attribute>
            </field>
            <!--
                Inserta, justo antes del campo city_id, dos labels
                mutuamente excluyentes según el flag cities_or_districts
                del país.

                Lógica:
                  cities_or_districts = True  → mostrar "District"
                  cities_or_districts = False → mostrar "City"
            -->
            <field name="city_id" position="before">
                <label for="city_id"
                       string="District"
                       invisible="country_id and not country_id.cities_or_districts"/>
                <label for="city_id"
                       string="City"
                       invisible="country_id and country_id.cities_or_districts"/>
            </field>
        </field>
    </record>

    <!--
        2) Vista del formulario embedido de child_ids (direcciones de
            contacto dentro de una empresa).
    -->
    <record id="view_partner_form_inherit_child_city_filter_pa" model="ir.ui.view">
        <field name="name">res.partner.form.child.city.filter.pa</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base_address_extended.address_street_extended_city_form"/>
        <field name="arch" type="xml">
            <!-- Filtra el city_id dentro del xpath de child_ids -->
            <xpath expr="//field[@name='child_ids']//field[@name='city_id']" position="attributes">
                <attribute name="domain">['|', ('state_id', '=', False), '&amp;', ('country_id', '=', country_id), '|', ('state_id', '=', state_id), ('state_id', '=', False)]</attribute>
                <attribute name="options">{'placeholder_field': 'city_id_placeholder', 'no_quick_create': True}</attribute>
            </xpath>
            <!-- Labels dinámicos para el city_id embebido -->
            <xpath expr="//field[@name='child_ids']//field[@name='city_id']" position="before">
                <label for="city_id"
                       string="District"
                       invisible="country_id and not country_id.cities_or_districts"/>
                <label for="city_id"
                       string="City"
                       invisible="country_id and country_id.cities_or_districts"/>
            </xpath>
        </field>
    </record>

</odoo>